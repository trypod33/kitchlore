<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kitchlore" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorBackground">@color/kitchlore_background</item>
        <item name="android:statusBarColor">@color/kitchlore_primary</item>
    </style>

    <!-- Cold-start splash: cream canvas with the cookbook icon centered,
